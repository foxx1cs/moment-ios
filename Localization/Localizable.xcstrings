    "В ПРЕДВКУШЕНИИ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "COUNTING DOWN"
          }
        }
      }
    },
    "МОМЕНТ НАСТАЛ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "THE MOMENT IS HERE"
          }
        }
      }
    },
    "Каждая секунда приближает": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every second brings it closer"
          }
        }
      }
    },
    "Время создавать новые воспоминания": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to make new memories"
          }
        }
      }
    },
    "Осталось: %lld дней, %lld часов, %lld минут, %lld секунд": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld days, %2$lld hours, %3$lld minutes, %4$lld seconds remaining"
          }
        }
      }
    },
    "У хорошего впереди есть точное время.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good things have a time and date."
