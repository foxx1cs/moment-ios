      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seconds"
          }
        }
      }
    },
    "ДНИ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DAYS"
          }
        }
      }
    },
    "ЧАСЫ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HOURS"
          }
        }
